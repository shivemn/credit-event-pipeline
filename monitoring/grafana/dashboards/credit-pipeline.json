        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (partition) (rate(pipeline_events_processed_total[30s]))",
          "legendFormat": "partition {{partition}}",
          "refId": "A"
        }
      ]
    },
